# /etc/espia/espia.env — modo 640, dono espia.
# Senha NÃO fica aqui: fica em /etc/espia/segredos/, e as variáveis *_FILE
# apontam para os arquivos.

ESPIA_AMBIENTE=producao
TZ=America/Sao_Paulo

PGHOST=pgcluster.interno.banco
PGPORT=5432
PGDATABASE=espia
PGUSER=espia_servico
PGPASSWORD_FILE=/etc/espia/segredos/pg_senha

REDIS_URL=rediss://redis.interno.banco:6379/0

ESPIA_TLS_CERT=/etc/espia/certs/espia.crt
ESPIA_TLS_KEY=/etc/espia/certs/espia.key
ESPIA_MTLS_CA=/etc/espia/certs/ca-interna.crt
ESPIA_EXIGIR_MTLS=true

ESPIA_OIDC_ISSUER=https://sso.interno.banco/realms/corporativo
ESPIA_MODO_SOMBRA=true
